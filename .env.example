# Copie para .env na raiz do projeto e TROQUE todas as credenciais de exemplo.
# Este arquivo .env.example pode ser versionado. O .env real NAO pode.

# Portas vistas pelo navegador ou por ferramentas instaladas no PC.
APP_PORT=3000
ADMINER_PORT=8080
DB_FORWARD_PORT=3307

# Configuracao do MySQL (nomes usados pelo Docker e pelo futuro db.js).
DB_NAME=vigia_arboviroses
DB_USER=vigia_app
DB_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL_FORTE
DB_ROOT_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_LOCAL_FORTE

# Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=SUBSTITUA_POR_SEQUENCIA_ALEATORIA_DE_32_OU_MAIS_CARACTERES
